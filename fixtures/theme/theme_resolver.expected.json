{
  "schema": "seventhslide.theme_resolver.v2",
  "output": {
    "id": "out-main",
    "name": "Main",
    "category_defaults": {
      "song": {
        "theme": "t_default",
        "bg": "b_default"
      },
      "bible": {
        "theme": "t_big",
        "bg": "b_blue"
      },
      "media": {
        "theme": "t_ann"
      }
    }
  },
