      "name": "song_defaults_only",
      "why": "A library song with nothing picked takes the song defaults.",
      "selection": {
        "mode": "song",
        "service_item_type": null,
        "service_theme_map": {},
        "content_theme_map": {},
        "theme_priority": [
          "content",
          "service",
          "global"
        ]
      },
      "theme_ids": {
        "theme": "t_default",
        "bg": "b_default"
      },
      "text_theme_id": "t_default",
      "style_spotlight": {
        "font_size": 48,
        "align": "center",
        "highlight_color": "#ffffff",
        "background_type": "color",
        "background_color": "#000000"
      }
    },
