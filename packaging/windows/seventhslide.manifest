<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Every SeventhSlide program on Windows (cmake/SeventhSlideWindows.cmake). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Runs as the person who started it; never asks to be an administrator. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- The program's narrow strings are UTF-8 (Windows 10 1903 and later):
           paths, getenv and argv in std::string and std::filesystem read as
           UTF-8 as on Linux and macOS, so a folder or user name with é or
           CJK in it is the same path, not the system code page's guess. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <!-- Paths past 260 characters, where the system allows them. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
