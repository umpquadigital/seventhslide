/// beta.
[[nodiscard]] constexpr std::string_view version_string() noexcept
{
    return "@SEVENTHSLIDE_VERSION@";
}

/// This build checks GitHub for newer versions (SEVENTHSLIDE_UPDATE_CHECK).
[[nodiscard]] constexpr bool update_check_enabled() noexcept
{
