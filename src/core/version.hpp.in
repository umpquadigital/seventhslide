}

/// The file of each release that this build was packaged as
/// (``seventhslide-ubuntu-24.04-amd64.deb``), and so the one it updates
/// from; empty for a build that was not packaged.
[[nodiscard]] constexpr std::string_view package_file() noexcept
{
